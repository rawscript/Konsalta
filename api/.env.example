PORT=3000
NODE_ENV=development

SMTP_HOST=mail.konsaltahub.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@konsaltahub.org
SMTP_PASSWORD=replace-with-the-current-mailbox-password
SMTP_FROM=no-reply@konsaltahub.org
CONTACT_TO=engage@konsaltahub.org
REPLY_TO=engage@konsaltahub.org

# Public HTTPS origin used to build confirmation and unsubscribe links.
PUBLIC_SITE_URL=https://konsaltahub.org

# Replace both values with unique admin credentials.
NEWSLETTER_ADMIN_USER=replace-with-a-private-admin-name
NEWSLETTER_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Keep this file on persistent storage, outside the public web root.
NEWSLETTER_DB_PATH=./data/newsletter.json
INSIGHTS_CONTENT_PATH=./data/insights-content.json

# Set only when the website is hosted on a different origin from this API.
ALLOWED_ORIGIN=

# Set to the exact number of trusted reverse proxies in front of this app.
TRUST_PROXY_HOPS=0
